<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- STATE 1: When the button is selected -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <!-- The highlight color for the background -->
            <solid android:color="@color/green4" />
            <!-- An optional stroke (outline) -->
            <stroke android:width="2dp" android:color="@color/orange1" />
            <!-- Optional rounded corners -->
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- STATE 2: The default, non-selected state -->
    <item>
        <shape android:shape="rectangle">
            <!-- A transparent background so only the icon is visible -->
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
