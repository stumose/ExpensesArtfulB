    <!-- The soft red for non-shared expenses. A standard Material Design color for errors on a dark surface. -->
    <color name="soft_red">#CF6679</color>

    <!-- Semantic Theme Colors (for Dark Mode) -->
    <color name="app_background">#121212</color>
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#FF121212</color>
    <color name="surface_color">#FFFFFFFF</color>
    <color name="blue_general">@color/material_dynamic_primary30</color>
    <color name="button_text_white">#FFFFFFFF</color>


</resources>
