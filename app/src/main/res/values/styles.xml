<!-- res/values/styles.xml -->
<resources>

    <!-- Your existing styles might already be here -->

    <style name="CustomSpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:backgroundTint">@color/orange1</item> <!-- Purple arrow background -->
    </style>

    <style name="CategoryIcon" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/category_background_selector</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

</resources>
